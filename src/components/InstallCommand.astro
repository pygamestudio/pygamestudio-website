---
/**
 * The `pip install pygamestudio` command with a copy button.
 *
 * Rendered under the hero image of the homepages, see `Hero.astro`.
 */
interface Props {
	command?: string;
	copyLabel?: string;
	copiedLabel?: string;
}

const {
	command = 'pip install pygamestudio',
	copyLabel = 'Copy',
	copiedLabel = 'Copied',
} = Astro.props;
---

<div class="install-command" data-install-command={command}>
	<span class="prompt" aria-hidden="true">$</span>
	<code>{command}</code>
	<button
		type="button"
		class="copy"
		data-copy-label={copyLabel}
		data-copied-label={copiedLabel}
		aria-label={`${copyLabel}: ${command}`}
	>
		<svg
			class="icon clipboard"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<rect x="9" y="9" width="13" height="13" rx="2"></rect>
			<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
		</svg>
		<svg
			class="icon check"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M20 6 9 17l-5-5"></path>
		</svg>
		<span class="label">{copyLabel}</span>
	</button>
</div>

<script>
	document.querySelectorAll('[data-install-command]').forEach((box) => {
		const button = box.querySelector('button.copy');
		const label = box.querySelector('.label');
		if (!button || !label) return;

		button.addEventListener('click', async () => {
			const command = box.getAttribute('data-install-command') || '';
			try {
				await navigator.clipboard.writeText(command);
			} catch (error) {
				// The clipboard API needs a secure context; select the text instead.
				const code = box.querySelector('code');
				if (!code) return;
				const range = document.createRange();
				range.selectNodeContents(code);
				const selection = window.getSelection();
				selection?.removeAllRanges();
				selection?.addRange(range);
			}
			box.classList.add('is-copied');
			label.textContent = button.getAttribute('data-copied-label') || label.textContent;
			window.setTimeout(() => {
				box.classList.remove('is-copied');
				label.textContent = button.getAttribute('data-copy-label') || label.textContent;
			}, 1600);
		});
	});
</script>

<style>
	.install-command {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		max-width: 100%;
		padding: 0.4rem 0.5rem 0.4rem 0.85rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-inline-code);
		font-size: var(--sl-text-sm);
		transition: border-color 0.15s ease-in-out;
	}

	.install-command:hover {
		border-color: var(--sl-color-gray-4);
	}

	.prompt {
		flex-shrink: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		user-select: none;
	}

	.install-command code {
		flex: 1 1 auto;
		min-width: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text);
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.copy {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
		padding: 0.3rem 0.4rem 0.3rem 0.7rem;
		border: none;
		border-left: 1px solid var(--sl-color-hairline);
		background: none;
		color: var(--sl-color-gray-2);
		font-family: inherit;
		font-size: var(--sl-text-xs);
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition: color 0.15s ease-in-out;
	}

	.copy:hover {
		color: var(--sl-color-text-accent);
	}

	.copy:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}

	.icon {
		flex-shrink: 0;
	}

	.check {
		display: none;
	}

	.install-command.is-copied .copy {
		color: var(--sl-color-green-high);
	}

	.install-command.is-copied .clipboard {
		display: none;
	}

	.install-command.is-copied .check {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.install-command,
		.copy {
			transition: none;
		}
	}
</style>
