---
/**
 * Starlight's sidebar, with every link pointing at the docs version the reader
 * is currently browsing, so opening an archived release never jumps back to the
 * current docs. `src/data/versioned-sidebar.ts` does the filtering and explains
 * how it works; `src/data/versions.ts` explains how versions are stored.
 */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { versionedSidebar } from '../data/versioned-sidebar';

const { sidebar } = Astro.locals.starlightRoute;
const entries = versionedSidebar(sidebar, Astro.url.pathname);
---

<SidebarPersister>
	<SidebarSublist sublist={entries} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
